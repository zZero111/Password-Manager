# Where the database lives (small; keep it on the built-in storage).
KEYHOLD_DATA=/var/lib/keyhold
# Where nightly backups go (put this on the other disk, e.g. the USB HDD).
BACKUP_DIR=/mnt/hdd/backups/keyhold
# How many nightly backups to keep.
KEEP=30
# Port on 127.0.0.1 that tailscale serve forwards to.
KEYHOLD_PORT=8080
# open while you create your Account(s), then closed.
SIGNUPS=open
